#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        mb2 {
            bindings = <&mkp MB2>;
            key-positions = <33 34>;
            layers = <0>;
        };

        mb3 {
            bindings = <&mkp MB3>;
            key-positions = <33 32>;
            layers = <0>;
        };

        mb4 {
            bindings = <&mkp MB4>;
            key-positions = <33 32>;
            layers = <3>;
        };

        mb5 {
            bindings = <&mkp MB5>;
            key-positions = <33 34>;
            layers = <3>;
        };

        mo4 {
            bindings = <&mo 4>;
            key-positions = <58 59>;
        };

        lang {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <57 60>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &none       &none     &none     &none      &none                                    &none      &none  &none      &none          &none         &none
&none  &kp Q       &kp W     &kp E     &kp R      &kp T                                    &kp Y      &kp U  &kp I      &kp O          &kp P         &none
&none  &kp A       &kp S     &kp D     &kp F      &kp G           &none        &none       &kp H      &kp J  &kp K      &kp L          &kp MINUS     &none
&none  &kp Z       &kp X     &kp C     &kp V      &kp B           &mkp MB1     &lt 5 SEMI  &kp N      &kp M  &kp COMMA  &kp DOT        &kp SLASH     &none
&none  &kp ESCAPE  &kp LGUI  &kp LALT  &lt 1 TAB  &kp LEFT_SHIFT  &lt 3 SPACE  &lt 2 RET   &kp LCTRL  &none  &none      &kp RIGHT_ALT  &kp LEFT_WIN  &none
            >;
        };

        signs {
            bindings = <
&none  &none         &none           &none             &none          &none                                 &none          &none         &none                 &none                  &none          &none
&none  &kp EXCL      &kp AT          &kp HASH          &kp DOLLAR     &kp PERCENT                           &kp CARET      &kp TILDE     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &none
&none  &kp QUESTION  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp PIPE       &kp SINGLE_QUOTE   &none   &none      &kp BACKSPACE  &kp PLUS      &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp MINUS      &none
&none  &kp GRAVE     &kp LESS_THAN   &kp GREATER_THAN  &kp AMPERSAND  &kp DOUBLE_QUOTES  &trans  &kp COLON  &kp EQUAL      &kp ASTERISK  &kp COMMA             &kp PERIOD             &kp SLASH      &none
&none  &trans        &trans          &trans            &trans         &trans             &trans  &trans     &trans         &none         &none                 &trans                 &trans         &none
            >;
        };

        nums {
            bindings = <
&none  &none         &none           &none             &none          &none                                 &none          &none         &none             &none              &none      &none
&none  &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3      &kp NUMBER_4   &kp N5                                &kp NUMBER_6   &kp N7        &kp N8            &kp N9             &kp N0     &none
&none  &kp QUESTION  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp PIPE       &kp SINGLE_QUOTE   &none   &none      &kp BACKSPACE  &kp PLUS      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp MINUS  &none
&none  &kp GRAVE     &kp LESS_THAN   &kp GREATER_THAN  &kp AMPERSAND  &kp DOUBLE_QUOTES  &trans  &kp COLON  &kp EQUAL      &kp ASTERISK  &kp COMMA         &kp PERIOD         &kp SLASH  &none
&none  &trans        &trans          &trans            &trans         &trans             &trans  &trans     &trans         &none         &none             &trans             &trans     &none
            >;
        };

        controls {
            bindings = <
&none  &none   &none    &none    &none    &none                   &none          &none           &none            &none            &none       &none
&none  &kp F1  &kp F2   &kp F3   &kp F4   &none                   &kp HOME       &kp PAGE_UP     &kp UP_ARROW     &kp PAGE_DOWN    &kp END     &none
&none  &kp F5  &kp F6   &kp F7   &kp F8   &none   &none   &none   &kp BACKSPACE  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp RIGHT_ARROW  &kp DELETE  &none
&none  &kp F9  &kp F10  &kp F11  &kp F12  &none   &none   &none   &none          &none           &kp LA(LS(TAB))  &kp LA(TAB)      &kp INS     &none
&none  &trans  &trans   &trans   &trans   &trans  &trans  &trans  &trans         &none           &none            &trans           &trans      &none
            >;
        };

        functions {
            bindings = <
&none  &none    &none    &none    &none    &none                   &none   &none        &none        &none        &none        &none
&none  &kp F13  &kp F14  &kp F15  &kp F16  &none                   &none   &kp LS(F13)  &kp LS(F14)  &kp LS(F15)  &kp LS(F16)  &none
&none  &kp F17  &kp F18  &kp F19  &kp F20  &none   &none   &none   &none   &kp LS(F17)  &kp LS(F18)  &kp LS(F19)  &kp LS(F20)  &none
&none  &kp F21  &kp F22  &kp F23  &kp F24  &none   &none   &none   &none   &kp LS(F21)  &kp LS(F22)  &kp LS(F23)  &kp LS(F24)  &none
&none  &trans   &trans   &trans   &trans   &trans  &trans  &trans  &trans  &none        &none        &trans       &trans       &none
            >;
        };

        device {
            bindings = <
&none  &none         &none         &none         &none         &none                                      &none     &none           &none           &none            &none     &none
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &kp C_VOLUME_UP                            &mkp MB4  &mkp MB1        &mmv MOVE_UP    &mkp MB2         &mkp MB5  &none
&none  &none         &none         &none         &none         &kp C_VOLUME_DOWN  &none           &none   &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none     &none
&none  &none         &none         &none         &none         &kp K_MUTE         &studio_unlock  &none   &none     &none           &none           &none            &none     &none
&none  &trans        &trans        &trans        &trans        &trans             &trans          &trans  &trans    &none           &none           &trans           &trans    &none
            >;
        };
    };
};
